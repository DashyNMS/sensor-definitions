{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/DashyNMS/sensor-definitions/main/schemas/catalogue-v1.schema.json",
  "title": "DashyNMS sensor definitions catalogue — draft schema 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "sources", "definitions"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "location", "revision", "licence"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["librenms-discovery", "mib-enum", "reviewed-override", "synthetic"] },
          "location": { "type": "string", "minLength": 1 },
          "revision": { "type": "string", "minLength": 1 },
          "licence": { "type": "string", "minLength": 1 },
          "notice": { "type": "string" }
        }
      }
    },
    "definitions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "match", "states", "sourceRefs"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "match": {
            "type": "object",
            "additionalProperties": false,
            "required": ["os", "sensorClass", "sensorType", "oidPrefix"],
            "properties": {
              "os": { "type": "string", "minLength": 1 },
              "sensorClass": { "const": "state" },
              "sensorType": { "type": "string", "minLength": 1 },
              "oidPrefix": { "type": "string", "pattern": "^[0-2](?:\\.(?:0|[1-9][0-9]*))+$" }
            }
          },
          "states": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["value", "label", "genericState"],
              "properties": {
                "value": { "type": "string", "pattern": "^(?:0|-?[1-9][0-9]*)$" },
                "label": { "type": "string", "minLength": 1 },
                "genericState": { "enum": ["ok", "warning", "critical", "unknown", null] }
              }
            }
          },
          "sourceRefs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["sourceId", "path", "symbol", "suppliesSeverity"],
              "properties": {
                "sourceId": { "type": "string", "minLength": 1 },
                "path": { "type": "string", "minLength": 1 },
                "symbol": { "type": "string", "minLength": 1 },
                "suppliesSeverity": { "type": "boolean" }
              }
            }
          }
        }
      }
    }
  }
}
