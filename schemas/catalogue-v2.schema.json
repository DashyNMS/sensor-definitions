{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/DashyNMS/sensor-definitions/main/schemas/catalogue-v2.schema.json",
  "title": "DashyNMS sensor definitions with bounded source context",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "sources",
    "definitions"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "location",
          "revision",
          "licence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "librenms-discovery",
              "mib-enum",
              "reviewed-override",
              "synthetic"
            ]
          },
          "location": {
            "type": "string",
            "minLength": 1
          },
          "revision": {
            "type": "string",
            "minLength": 1
          },
          "licence": {
            "type": "string",
            "minLength": 1
          },
          "notice": {
            "type": "string"
          }
        }
      }
    },
    "definitions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "match",
          "states",
          "sourceRefs"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "match": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "os",
              "sensorClass",
              "sensorType",
              "oidPrefix"
            ],
            "properties": {
              "os": {
                "type": "string",
                "minLength": 1
              },
              "sensorClass": {
                "const": "state"
              },
              "sensorType": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "oidPrefix": {
                "type": "string",
                "pattern": "^[0-2](?:\\.(?:0|[1-9][0-9]*))+$"
              },
              "typeMatch": {
                "enum": [
                  "exact",
                  "template",
                  "any"
                ]
              },
              "oidSuffix": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024,
                "pattern": "^(?:0|[1-9][0-9]*)(?:\\.(?:0|[1-9][0-9]*))*$"
              },
              "conditions": {
                "type": [
                  "array",
                  "null"
                ],
                "maxItems": 16,
                "items": {
                  "$ref": "#/$defs/condition"
                }
              }
            }
          },
          "states": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "value",
                "label",
                "genericState"
              ],
              "properties": {
                "value": {
                  "type": "string",
                  "pattern": "^(?:0|-?[1-9][0-9]*)$"
                },
                "label": {
                  "type": "string",
                  "minLength": 1
                },
                "genericState": {
                  "enum": [
                    "ok",
                    "warning",
                    "critical",
                    "unknown",
                    null
                  ]
                }
              }
            }
          },
          "sourceRefs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "sourceId",
                "path",
                "symbol",
                "suppliesSeverity"
              ],
              "properties": {
                "sourceId": {
                  "type": "string",
                  "minLength": 1
                },
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "symbol": {
                  "type": "string",
                  "minLength": 1
                },
                "suppliesSeverity": {
                  "type": "boolean"
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "condition": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "field",
            "op",
            "value"
          ],
          "properties": {
            "field": {
              "enum": [
                "os",
                "hardware",
                "version",
                "sysObjectID"
              ]
            },
            "op": {
              "enum": [
                "equals",
                "notEquals",
                "contains"
              ]
            },
            "value": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "field",
            "op"
          ],
          "properties": {
            "field": {
              "enum": [
                "os",
                "hardware",
                "version",
                "sysObjectID"
              ]
            },
            "op": {
              "const": "present"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "all"
          ],
          "properties": {
            "all": {
              "type": "array",
              "minItems": 1,
              "maxItems": 16,
              "items": {
                "$ref": "#/$defs/condition"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "any"
          ],
          "properties": {
            "any": {
              "type": "array",
              "minItems": 1,
              "maxItems": 16,
              "items": {
                "$ref": "#/$defs/condition"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "not"
          ],
          "properties": {
            "not": {
              "$ref": "#/$defs/condition"
            }
          }
        }
      ]
    }
  }
}
